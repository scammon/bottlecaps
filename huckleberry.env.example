# Copy to huckleberry.env and fill in your Huckleberry account credentials.
HUCKLEBERRY_EMAIL=
HUCKLEBERRY_PASSWORD=
HUCKLEBERRY_TIMEZONE=America/New_York
HUCKLEBERRY_BOTTLE_TYPE=Formula
# Optional: only needed if your account has more than one child profile.
# Find it by hitting the huckleberry service's /whoami endpoint once
# credentials are set (see README).
#HUCKLEBERRY_CHILD_UID=
